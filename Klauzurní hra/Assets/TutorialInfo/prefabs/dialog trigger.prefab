--- !u!114 &7907512416551062162
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3335253922782218554}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: af6c4a1362fcea5469be8f143bb638e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TriggerDialogue3D
  isConversation: 1
  single3DText: {fileID: 0}
  singleSentence: 
  clearDelay: 2
  conversationLines:
  - speaker3DText: {fileID: 1408554341383361051}
    sentence: Hey, is your terminal freezing too?
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 6672767327858594040}
    sentence: Yeah. Just leave it alone, the network is updating.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 1408554341383361051}
    sentence: It's been updating for twenty minutes. I just have a blinking cursor
      here.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 6672767327858594040}
    sentence: Don't press anything, or you'll crash the whole subnet again.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 1408554341383361051}
    sentence: I didn't crash it last time, that was a power surge.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 6672767327858594040}
    sentence: Sure it was. Anyway, did you order the food?
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 1408554341383361051}
    sentence: I tried, but the intranet won't even load the menu.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 6672767327858594040}
    sentence: Great. So we are starving until 3 AM.
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 1408554341383361051}
    sentence: I'll just try hitting refresh...
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  - speaker3DText: {fileID: 6672767327858594040}
    sentence: I swear to god, if my screen goes black...
    textColor: {r: 1, g: 1, b: 1, a: 1}
    delayAfter: 1
  typingSpeed: 0.05
  playOnlyOnce: 0
  loopContinuously: 1
